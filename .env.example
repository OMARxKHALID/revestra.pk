# Optional. Without it the bundled catalogue in src/lib/products.js is used,
# accounts and gateway payments are disabled, and cash on delivery is the only
# checkout option. When it IS set but unreachable, the shop fails loudly rather
# than quietly serving the bundled demo catalogue.
# Atlas looks like: mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
# Keep the real value in .env.local, which git ignores. Never commit it.
MONGODB_URI=
MONGODB_DB=general-store

# Used by metadata, sitemap.xml, robots.txt and every gateway return URL.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Required for sign-in and for signing order-tracking links.
# Generate one with: bunx auth secret
AUTH_SECRET=

# Order confirmation emails. Unset, the email is logged to the console instead.
RESEND_API_KEY=
EMAIL_FROM=

# Payment gateways. "live" switches both gateways to production endpoints.
PAYMENT_ENV=sandbox

# Which gateway backs the "Debit or credit card" tile: jazzcash or easypaisa.
PAYMENT_CARD_PROVIDER=jazzcash

# JazzCash merchant credentials. All three are required for JazzCash to appear.
# Never prefix these with NEXT_PUBLIC_ — the integrity salt signs every request.
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=

# Easypaisa merchant credentials. The hash key must be exactly 16 characters.
# Every one of these is required: settlement is confirmed by a server-to-server
# transaction inquiry, never by trusting the browser postback, so Easypaisa
# stays hidden at checkout until the inquiry credentials are present too.
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_ACCOUNT_NUM=
EASYPAISA_USERNAME=
EASYPAISA_PASSWORD=

# How many proxies sit in front of the app. Rate limiting reads the client IP
# this many hops from the right of x-forwarded-for, so a client cannot spoof it.
TRUSTED_PROXY_HOPS=1

# Image hosting for product pictures and review photos.
# Signed uploads only — the secret never reaches the browser, the app hands the
# admin a short-lived signature and the file goes straight to Cloudinary.
# Without these three, the uploader tells the admin it is not configured.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Shared secret for machine-to-machine cron calls, such as `bun run release-stale`.
# Generate one with `openssl rand -hex 32`. Without it the cron endpoint answers 404.
CRON_SECRET=

# PostHog. Leave the token blank to switch analytics off entirely — no browser
# requests are made and no server events are sent. Ingestion is proxied through
# /ph by next.config.mjs, so the strict CSP needs no widening.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Match your project region: https://us.i.posthog.com or https://eu.i.posthog.com
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
